<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DeckForge.Agent</RootNamespace>
    <AssemblyName>DeckForge.Agent</AssemblyName>
    <Version>0.1.0</Version>
    <Description>DeckForge Windows agent — hosts the phone Stream Deck (mDNS + WebSocket + JSON-RPC 2.0)</Description>
  </PropertyGroup>

  <!-- Kestrel for the WebSocket server (bundled with the .NET SDK; no admin/urlacl needed). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="assets\layout.default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
