<UserControl x:Class="Relay.Agent.Views.DeckEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Preset chooser (manage presets in the Presets tab) -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Preset" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"
                       Margin="0,0,8,0" DockPanel.Dock="Left"/>
            <ComboBox x:Name="PresetBox" Width="190" DockPanel.Dock="Left" SelectionChanged="Preset_Changed"/>
            <TextBlock Text="Editing this deck — add/rename presets in the Presets tab." VerticalAlignment="Center"
                       Foreground="{StaticResource TextMuted}" Margin="14,0,0,0"/>
        </DockPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Deck editor" Style="{StaticResource H1}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Cols" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,6,0"/>
                <ComboBox x:Name="ColsBox" Width="58" SelectionChanged="Grid_Changed"/>
                <TextBlock Text="Rows" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="14,0,6,0"/>
                <ComboBox x:Name="RowsBox" Width="58" SelectionChanged="Grid_Changed"/>
                <Button Content="Add button" Margin="16,0,0,0" Click="Add_Click"/>
                <Button Content="Duplicate" Margin="8,0,0,0" Click="Duplicate_Click"/>
                <Button Content="Save &amp; Push" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- Phone-like preview -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Page" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="PageBox" Width="170" SelectionChanged="Page_Changed"/>
                        <Button Content="Add" Margin="8,0,0,0" Click="AddPage_Click"/>
                        <Button Content="Rename" Margin="6,0,0,0" Click="RenamePage_Click"/>
                        <Button Content="Delete" Margin="6,0,0,0" Click="DeletePage_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="Hint" Text="Drag buttons to arrange them. Click a button to edit it."
                               Style="{StaticResource Muted}" Margin="2,0,0,12"/>
                    <!-- Slider row authoring (deck-wide; drives a MicForge param) -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Sliders" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <Button Content="＋ Add MicForge slider" HorizontalAlignment="Right" Click="AddSlider_Click"/>
                        </DockPanel>
                        <StackPanel x:Name="SlidersHost"/>
                        <TextBlock x:Name="SlidersHint" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="{StaticResource Bg}" CornerRadius="20" Padding="14">
                            <UniformGrid x:Name="GridHost"/>
                        </Border>
                    </Viewbox>
                </DockPanel>
            </Border>

            <!-- Button library -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
                <DockPanel>
                    <TextBlock Text="Library" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"
                               DockPanel.Dock="Top"/>
                    <TextBlock Text="Save buttons here, then drag them onto any preset page."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                               DockPanel.Dock="Top"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Content="Save selected" Click="SaveButtonToLibrary_Click"/>
                        <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                Click="DeleteLibraryButton_Click"/>
                    </StackPanel>
                    <ListBox x:Name="LibraryList"
                             PreviewMouseLeftButtonDown="Library_PreviewMouseLeftButtonDown"
                             MouseMove="Library_MouseMove">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Button.Label}" Style="{StaticResource Muted}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Properties -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="16,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Button" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <StackPanel x:Name="Fields">
                            <TextBlock Text="Label" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <TextBox x:Name="LabelBox" Margin="0,0,0,14"/>

                            <TextBlock Text="ACTION" Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                                       FontSize="11" Margin="0,4,0,8"/>
                            <ComboBox x:Name="TypeBox" Margin="0,0,0,10" SelectionChanged="Type_Changed"/>
                            <StackPanel x:Name="ParamHost" Margin="0,0,0,6"/>

                            <TextBlock Text="APPEARANCE" Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                                       FontSize="11" Margin="0,12,0,8"/>
                            <TextBlock Text="Icon" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="IconPreview" Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                                        Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"/>
                                <ComboBox x:Name="IconBox" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                          SelectionChanged="Icon_Changed">
                                    <ComboBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Width="240"/>
                                        </ItemsPanelTemplate>
                                    </ComboBox.ItemsPanel>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                       Width="40" Height="40" TextAlignment="Center" Padding="0,7,0,0"
                                                       ToolTip="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="From URL…" Click="IconFromUrl_Click"/>
                                <Button Content="Upload…" Margin="8,0,0,0" Click="IconUpload_Click"/>
                                <Button Content="Clear" Margin="8,0,0,0" Click="IconClear_Click"/>
                            </StackPanel>

                            <TextBlock Text="Colour" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ColorBox" Grid.Column="0" TextChanged="Color_Changed"/>
                                <Border x:Name="Swatch" Grid.Column="1" Width="30" Height="30" CornerRadius="6"
                                        Margin="8,0,0,0" BorderBrush="{StaticResource Border}" BorderThickness="1"/>
                                <Button Grid.Column="2" Content="…" Width="34" Margin="8,0,0,0" Click="Pick_Click"/>
                            </Grid>

                            <TextBlock Text="Press effect" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="EffectBox" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Apply" Style="{StaticResource AccentButton}" Click="Apply_Click"/>
                                <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Delete_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="EmptyHint" Text="Select a button, or Add one." Style="{StaticResource Muted}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
