<UserControl x:Class="Relay.Agent.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Devices" Style="{StaticResource H1}" Margin="0,0,0,4"/>
            <TextBlock Text="Pair a phone on the same network, then control your PC from it."
                       Style="{StaticResource Muted}" Margin="0,0,0,20"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="8">
                        <Image x:Name="Qr" Width="176" Height="176"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,2,0,0">
                        <TextBlock Text="Pair a phone" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Enter these in the Relay app on your phone:" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock x:Name="HostLine" Margin="0,3" FontSize="14"/>
                        <TextBlock x:Name="PortLine" Margin="0,3" FontSize="14"/>
                        <TextBlock x:Name="TokenLine" Margin="0,3" FontSize="14" TextWrapping="Wrap"/>
                        <Button Content="Copy pairing link" Click="CopyUri_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click"/>
                        <TextBlock Text="Connected phones" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl x:Name="PhonesList" Margin="0,14,0,0"/>
                    <TextBlock x:Name="NoPhones" Text="No phones connected right now." Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
