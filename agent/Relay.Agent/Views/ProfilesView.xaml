<UserControl x:Class="Relay.Agent.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Profiles" Style="{StaticResource H1}" Margin="0,0,0,6"/>
            <TextBlock Text="Auto-switch the active deck to follow the app you're using."
                       Style="{StaticResource Muted}" Margin="0,0,0,20"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Auto-switch by app" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="When on, focusing an app applies its rule's deck. Switching decks by hand holds until you focus a different app."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button x:Name="EnableToggle" Click="EnableToggle_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Default deck" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Applied when the focused app matches no rule. Leave as “(leave as-is)” to not change the deck."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ComboBox x:Name="DefaultBox" Width="260" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Rules" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="App (.exe)" Style="{StaticResource Muted}"/>
                        <TextBlock Grid.Column="1" Text="Title contains (optional)" Style="{StaticResource Muted}" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="Deck" Style="{StaticResource Muted}" Margin="8,0,0,0"/>
                    </Grid>
                    <StackPanel x:Name="RulesHost"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Add rule" Click="AddRule_Click" Margin="0,0,10,0"/>
                        <Button Content="Add current app" Click="AddCurrent_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="Save" Style="{StaticResource AccentButton}" Click="Save_Click" Margin="0,0,12,0"/>
                <TextBlock x:Name="Hint" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
