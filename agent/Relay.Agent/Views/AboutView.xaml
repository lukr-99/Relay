<UserControl x:Class="Relay.Agent.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The About page: a hero, the author's card, the facts and the credits. Colors come from the
         Tray.* brushes (DynamicResource), so it follows the light and dark theme. No animation. -->
    <UserControl.Resources>
        <!-- A link button on the author card: a name, the handle under it, and the accent on hover. -->
        <Style x:Key="LinkTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Tray.TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{DynamicResource Tray.SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource Tray.BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="16,12" MinWidth="170">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Tray.PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Tray.FocusBrush}"/>
                                <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Tray.TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,28,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="32,28,32,36" HorizontalAlignment="Center">

            <!-- Hero -->
            <StackPanel HorizontalAlignment="Center">
                <Border Width="76" Height="76" CornerRadius="20" HorizontalAlignment="Center"
                        Background="{DynamicResource Tray.SurfaceBrush}" BorderBrush="{DynamicResource Tray.PrimaryBrush}" BorderThickness="2">
                    <Image x:Name="Logo" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="Relay" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock Text="An Android phone as a Stream Deck for Windows." FontSize="15" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,12,0,0"
                           Foreground="{DynamicResource Tray.TextSecondaryBrush}"/>
            </StackPanel>

            <!-- The author's card: a double frame, a seal with the initials, the name, the invitation. -->
            <Border Margin="0,28,0,0" CornerRadius="18" BorderThickness="2" BorderBrush="{DynamicResource Tray.PrimaryBrush}"
                    Background="{DynamicResource Tray.SurfaceBrush}">
                <Border Margin="4" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Tray.BorderBrush}"
                        Padding="24,28,24,22">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="0.7">
                            <GradientStop Color="#2E7C5CFF" Offset="0"/>
                            <GradientStop Color="#007C5CFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center"
                                Background="{DynamicResource Tray.PrimaryBrush}">
                            <TextBlock x:Name="Monogram" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Tray.OnPrimaryBrush}"/>
                        </Border>
                        <TextBlock Text="Made by" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"
                                   Foreground="{DynamicResource Tray.PrimaryBrush}"/>
                        <TextBlock x:Name="AuthorName" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>

                        <Rectangle Height="1" Margin="40,20,40,18" Fill="{DynamicResource Tray.BorderBrush}"/>

                        <TextBlock Text="Feedback is welcome" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="What works, what does not, what is missing. Write on Instagram, or open an issue on GitHub."
                                   FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,16"
                                   Foreground="{DynamicResource Tray.TextSecondaryBrush}"/>

                        <WrapPanel HorizontalAlignment="Center">
                            <Button x:Name="InstagramButton" Style="{StaticResource LinkTile}" Click="Instagram_Click"
                                    AutomationProperties.Name="Instagram, opens in your browser">
                                <StackPanel>
                                    <TextBlock Text="Instagram" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="InstagramHandle" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="GitHubButton" Style="{StaticResource LinkTile}" Click="GitHub_Click"
                                    AutomationProperties.Name="GitHub, opens in your browser">
                                <StackPanel>
                                    <TextBlock Text="GitHub" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="GitHubHandle" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="IssuesButton" Style="{StaticResource LinkTile}" Click="Issues_Click"
                                    AutomationProperties.Name="Relay issues on GitHub, opens in your browser">
                                <StackPanel>
                                    <TextBlock Text="Issues" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Report a problem" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Facts -->
            <TextBlock Text="About Relay" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Version" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FactVersion" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" Text="What it does" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="This agent runs on your PC and carries out the buttons you press on the phone app."/>
                    <TextBlock Grid.Row="2" Text="Connection" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Your local network, over TLS with a pairing token. No cloud and no account."/>
                    <TextBlock Grid.Row="3" Text="Licence" Style="{StaticResource Muted}"/>
                    <StackPanel Grid.Row="3" Grid.Column="1">
                        <TextBlock x:Name="LicenseText"/>
                        <TextBlock Text="Free for noncommercial use." Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Credits -->
            <TextBlock Text="Credits and licences" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <ItemsControl x:Name="CreditsList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Use}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding License}" Style="{StaticResource Muted}"
                                           VerticalAlignment="Top" Margin="16,2,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock x:Name="RepoLink" Style="{StaticResource Muted}" Margin="2,6,0,0">
                <Hyperlink x:Name="RepoHyperlink" Click="Repo_Click" Foreground="{DynamicResource Tray.PrimaryBrush}">Source code on GitHub</Hyperlink>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
