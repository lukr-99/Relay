<UserControl x:Class="Relay.Agent.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:tray="https://github.com/lukr-99/dotnetlib/tray">
    <!-- The settings page from the dotnetlib kit, in CodePrint's "Settings pages" shape: one scrolling
         page, one card per section, no Save button. Every change saves at once. -->
    <tray:SettingsPage x:Name="Page" Title="Settings">

        <tray:SettingsSection SectionId="general" Title="General" Description="How Relay looks.">
            <tray:SegmentedRow x:Name="ThemeRow" Label="Theme" Hint="System follows the Windows setting."
                               SelectionChanged="Theme_Changed">
                <tray:SegmentedRow.Options>
                    <x:Array Type="sys:String">
                        <sys:String>System</sys:String>
                        <sys:String>Light</sys:String>
                        <sys:String>Dark</sys:String>
                    </x:Array>
                </tray:SegmentedRow.Options>
            </tray:SegmentedRow>
        </tray:SettingsSection>

        <tray:SettingsSection SectionId="agent" Title="Agent" Description="How phones find and reach this PC.">
            <tray:InfoRow x:Name="NameRow" Label="Device name" Hint="Phones see this name when they search the network." />
            <tray:InfoRow x:Name="AddressRow" Label="Address" Hint="The pairing QR on the Devices tab carries it." IsMonospace="True" />
            <tray:SettingsDangerZone>
                <tray:DangerRow x:Name="RegenRow" Label="Regenerate the pairing token"
                                Hint="Unpairs every phone. You pair them again after a restart."
                                ButtonText="Regenerate..." Click="Regen_Click"
                                ConfirmTitle="Regenerate the pairing token?" ConfirmText="Regenerate" CancelText="Cancel"
                                ConfirmMessage="Every paired phone stops working until you restart Relay and pair it again." />
            </tray:SettingsDangerZone>
        </tray:SettingsSection>

        <tray:SettingsSection SectionId="presets" Title="Presets" Description="Ready-made decks. Manage them in the Presets tab.">
            <tray:ButtonRow x:Name="MicForgeRow" Label="MicForge preset" Hint="Buttons and sliders for MicForge."
                            ButtonText="Add" Click="AddMicForge_Click" />
            <tray:ButtonRow x:Name="CodingRow" Label="Coding preset" Hint="Shortcuts for coding."
                            ButtonText="Add" Click="AddCoding_Click" />
        </tray:SettingsSection>

        <tray:SettingsSection SectionId="automation" Title="Automation" Description="What deck buttons may do on this PC.">
            <tray:ToggleRow x:Name="ScriptRow" Label="Run-command buttons"
                            Hint="Lets a deck button run a shell command on this PC. Off by default."
                            Toggled="Script_Toggled" />
        </tray:SettingsSection>

        <tray:SettingsSection SectionId="data" Title="Your data" Description="Back up or share your deck, and find Relay's files.">
            <tray:ButtonRow x:Name="ExportRow" Label="Export the deck" Hint="Saves the current preset to a file."
                            ButtonText="Export..." Click="Export_Click" />
            <tray:ButtonRow x:Name="ImportRow" Label="Import a deck" Hint="Replaces the current preset and sends it to your phones."
                            ButtonText="Import..." Click="Import_Click" />
            <tray:LinkRow Label="Open the data folder" IsExternal="True" Click="OpenData_Click" />
            <tray:LinkRow Label="Open the log file" IsExternal="True" Click="OpenLog_Click" />
        </tray:SettingsSection>

        <tray:SettingsSection SectionId="updates" Title="Updates" Description="New versions of the Relay agent.">
            <tray:InfoRow x:Name="VersionRow" Label="Version" />
            <tray:ButtonRow x:Name="CheckRow" Label="Check for updates" Hint="Looks for a newer release on GitHub."
                            ButtonText="Check now" BusyText="Checking..." Click="CheckUpdate_Click" />
            <tray:ButtonRow x:Name="InstallRow" Label="Install the update" Visibility="Collapsed" IsPrimary="True"
                            ButtonText="Install" BusyText="Downloading..." Click="InstallUpdate_Click" />
            <tray:LinkRow Label="Release notes" IsExternal="True" Click="Releases_Click" />
        </tray:SettingsSection>

        <tray:SettingsSection SectionId="about" Title="About" Description="An Android phone as a Stream Deck for Windows.">
            <tray:LinkRow Label="Open the repository" IsExternal="True" Click="Repo_Click" />
        </tray:SettingsSection>
    </tray:SettingsPage>
</UserControl>
