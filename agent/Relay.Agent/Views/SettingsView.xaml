<UserControl x:Class="Relay.Agent.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,20"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Agent" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="NameLine" Margin="0,3" FontSize="14"/>
                    <TextBlock x:Name="PortLine" Margin="0,3" FontSize="14"/>
                    <TextBlock Text="Changing the port needs a restart." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Presets" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Add ready-made decks for MicForge controls or coding shortcuts. Manage presets in the Presets tab."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="＋ MicForge preset" Click="AddMicForge_Click"/>
                        <Button Content="＋ Coding preset" Click="AddCoding_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Files" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Open data folder" Click="OpenData_Click" Margin="0,0,10,0"/>
                        <Button Content="Open log file" Click="OpenLog_Click"/>
                    </StackPanel>
                    <TextBlock Text="Back up or share your deck." Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Export deck…" Click="Export_Click" Margin="0,0,10,0"/>
                        <Button Content="Import deck…" Click="Import_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Automation" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Run-command buttons let a deck button run a shell command on this PC. Off by default."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button x:Name="ScriptToggle" Click="ScriptToggle_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Pairing security" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Regenerate the token to unpair every phone. You'll re-pair after a restart."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button Content="Regenerate token" Style="{StaticResource DangerButton}" Click="Regen_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Updates" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="UpdateLine" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CheckUpdateBtn" Content="Check for updates" Click="CheckUpdate_Click"/>
                        <Button x:Name="InstallUpdateBtn" Content="Download &amp; install" Style="{StaticResource AccentButton}"
                                Margin="10,0,0,0" Visibility="Collapsed" Click="InstallUpdate_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="AboutLine" FontSize="14" Margin="0,0,0,10"/>
                    <Button Content="Open the repository" Click="Repo_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
