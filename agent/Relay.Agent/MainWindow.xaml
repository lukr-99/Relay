<Window x:Class="Relay.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relay" Width="1020" Height="700" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        TextElement.Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Nav rail -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,16,22">
                    <Image x:Name="Brand" Width="28" Height="28"/>
                    <TextBlock Text="Relay" FontSize="19" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,12,16,16">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavDeck" Style="{StaticResource NavButton}" GroupName="nav" IsChecked="True"
                                 Content="Deck editor" Checked="NavDeck_Checked"/>
                    <RadioButton x:Name="NavPresets" Style="{StaticResource NavButton}" GroupName="nav"
                                 Content="Presets" Checked="NavPresets_Checked"/>
                    <RadioButton x:Name="NavDevices" Style="{StaticResource NavButton}" GroupName="nav"
                                 Content="Devices" Checked="NavDevices_Checked"/>
                    <RadioButton x:Name="NavProfiles" Style="{StaticResource NavButton}" GroupName="nav"
                                 Content="Profiles" Checked="NavProfiles_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="nav"
                                 Content="Settings" Checked="NavSettings_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl x:Name="Host" Grid.Column="1"/>
    </Grid>
</Window>
